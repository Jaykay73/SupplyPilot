# SupplyPilot Environment Configuration Template

# Application
APP_ENV=development
API_PORT=8000
FRONTEND_PORT=3000
DEMO_DATE=2026-10-01
CURRENCY=EUR
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Authentication & Security
JWT_SECRET=demo-super-secret-key-change-in-production-min-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Database (PostgreSQL for Cloud/Staging; SQLite fallback supported for zero-dependency local runs)
# PostgreSQL example: postgresql+psycopg://postgres:postgres@localhost:5432/supplypilot
# SQLite local example: sqlite+aiosqlite:///./supplypilot.db
DATABASE_URL=sqlite+aiosqlite:///./supplypilot.db

# Vector Database (Qdrant Cloud or local embedded)
# Cloud example: https://xyz.cloud.qdrant.io:6333
# Local embedded: leave QDRANT_URL empty or use :memory:
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION_NAME=supplypilot_policies

# LLM Provider Configuration
# Supported providers: deepseek, openai, mock
LLM_PROVIDER=deepseek
LLM_MODEL=deepseek-chat
DEEPSEEK_API_KEY=

# Jev Probabilistic Decision Support (via Vercel AI Gateway)
JEV_ENABLED=false
JEV_MODEL=typesafe-ai/jev
AI_GATEWAY_API_KEY=
AI_GATEWAY_URL=https://ai-gateway.vercel.sh/v1

# Approval Thresholds (in configured CURRENCY)
THRESHOLD_AUTO_EXECUTE_MAX=5000
THRESHOLD_PROCUREMENT_MAX=25000
